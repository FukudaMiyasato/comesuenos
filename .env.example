# Transcripción (basta con UNA de las dos claves). Groq es gratis y rápido.
GROQ_API_KEY=
OPENAI_API_KEY=

# Opcional: modelo para clasificar sentimiento y categorías (por defecto el más barato).
CLASSIFY_MODEL=

# Idioma esperado del audio (ISO-639-1). Vacío = autodetectar.
STT_LANGUAGE=es

# Opcional: si lo defines, el ESP32 debe enviar el mismo valor en la cabecera x-device-token.
DEVICE_TOKEN=

# En Vercel: añade la integración "Upstash for Redis" (Marketplace) y estas
# variables se crean solas. En local no hacen falta (se guarda en memoria).
KV_REST_API_URL=
KV_REST_API_TOKEN=
